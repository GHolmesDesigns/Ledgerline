{
  "name": "ledgerline",
  "version": "0.0.3",
  "private": true,
  "description": "Personal Florida home finder: rank listings, compare the monthly cost of owning against comparable rent, and see flood, insurance, HOA, and CDD exposure. Local-first.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev --workspace @ledgerline/api\" \"npm:dev --workspace @ledgerline/web\"",
    "build": "npm run build --workspace @ledgerline/api && npm run build --workspace @ledgerline/web",
    "import:mock": "tsx apps/api/src/providers/import-cli.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"*.{json,js,mjs,ts}\" \"e2e/**/*.ts\"",
    "test:unit": "npm run test --workspaces --if-present && npm run test:launcher",
    "test:launcher": "node --test \"tools/desktop-launcher/**/*.test.mjs\"",
    "launcher:icon": "node tools/desktop-launcher/build-icon.mjs",
    "launcher:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/desktop-launcher/create-shortcut.ps1",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run format:check && npm run test:unit && npm run test:e2e && node fixtures/check-fixtures.mjs"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.4.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
